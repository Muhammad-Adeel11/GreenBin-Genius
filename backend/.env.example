# ─────────────────────────────────────────────────────────
# GreenBin Genius  –  Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/greenbin?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080     # 7 days

# Model paths (relative to backend root)
CNN_MODEL_PATH=ml/trashbox_cnn_model.h5
FOOD_WASTE_MODEL_PATH=ml/food_waste_savedmodel
YOLO_MODEL_PATH=ml/combined_waste_yolo_212_cate_best.pt

# App Settings
APP_ENV=development          # development | production
APP_VERSION=1.0.0
